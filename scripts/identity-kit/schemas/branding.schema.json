{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App identity and social-image content",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "shortName", "description", "url", "lang", "locale", "icon", "social", "pages"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "shortName": {"type": "string", "minLength": 1, "maxLength": 24},
    "description": {"type": "string", "minLength": 1, "maxLength": 300},
    "url": {"type": "string", "format": "uri"},
    "lang": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"},
    "locale": {"type": "string", "pattern": "^[a-z]{2,3}_[A-Z]{2}$"},
    "icon": {
      "type": "object", "additionalProperties": false, "required": ["background", "foreground"],
      "properties": {"background": {"$ref": "#/$defs/color"}, "foreground": {"$ref": "#/$defs/color"}}
    },
    "social": {
      "type": "object", "additionalProperties": false, "required": ["title", "label"],
      "properties": {"title": {"$ref": "#/$defs/title"}, "label": {"type": "string", "minLength": 1, "maxLength": 70}}
    },
    "pages": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["slug", "path", "title", "description"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "minLength": 1},
          "title": {"$ref": "#/$defs/title"},
          "description": {"type": "string", "minLength": 1, "maxLength": 300},
          "generateImage": {"type": "boolean"},
          "design": {"type": "string"},
          "mode": {"enum": ["light", "dark"]},
          "image": {
            "type": "object", "additionalProperties": false, "required": ["url", "alt"],
            "properties": {
              "url": {"type": "string", "format": "uri"}, "alt": {"type": "string", "minLength": 1},
              "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
              "type": {"enum": ["image/png", "image/jpeg", "image/webp"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 180}
  }
}
